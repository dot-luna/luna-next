{
  "name": "@luna/api",
  "version": "0.0.1",
  "private": true,
  "description": "Shared Luna APIs for the Bun runtime.",
  "homepage": "https://github.com/dot-luna/luna-next#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dot-luna/luna-next.git",
    "directory": "packages/luna-api"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun build ./src/index.ts --target bun --format esm --packages external --outdir dist --sourcemap=external",
    "build:hardware-helper": "bun build ./src/hardware/helper-main.ts --compile --outfile ./dist/luna-hardware-helper",
    "check": "tsc --noEmit",
    "test": "bun test tests"
  },
  "dependencies": {
    "pathe": "^2.0.3",
    "zod": "^4.6.7"
  }
}
