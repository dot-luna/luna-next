{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent_foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "bright_foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "comment": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "dark_background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "dark_foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "darker_background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "error": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "error_emphasis": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "error_foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "info": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "info_emphasis": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "info_foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "light_foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "lighter_background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "link": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "link_emphasis": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "mode": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "notice": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "notice_foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "secondary_accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "secondary_accent_emphasis": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "secondary_accent_foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "selection": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "selection_foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "success": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "success_emphasis": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "success_foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "warning": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "warning_emphasis": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "warning_foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\x00-\\x1f\\x7f]*\\S[^\\x00-\\x1f\\x7f]*$"
        },
        "mono": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\x00-\\x1f\\x7f]*\\S[^\\x00-\\x1f\\x7f]*$"
        }
      }
    },
    "wallpaper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gaps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inner": {
              "type": "integer",
              "minimum": 0
            },
            "outer": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "border_width": {
          "type": "integer",
          "minimum": 0
        },
        "rounding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "opacity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "active": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "inactive": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "fullscreen": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "blur": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "passes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        },
        "shadow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "range": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "falloff": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Luna Next theme source"
}
