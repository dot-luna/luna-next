{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "mode": {
          "enum": [
            "dark",
            "light"
          ]
        }
      }
    }
  }
}
