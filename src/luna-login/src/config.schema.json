{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Luna Login configuration",
  "type": "object",
  "properties": {
    "screen": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$", "maxLength": 100 }
      }
    },
    "wallpaper": {
      "type": "object",
      "properties": {
        "source": {
          "description": "An absolute local media path, or empty for the background only.",
          "type": "string",
          "anyOf": [{ "const": "" }, { "pattern": "^/" }],
          "not": { "pattern": "[\\u0000-\\u001f\\u007f]" }
        },
        "type": { "enum": ["auto", "image", "video"] },
        "fit": { "enum": ["fill", "fit", "stretch", "center", "tile"] },
        "background_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "colors": { "type": "object" },
    "fonts": { "type": "object" }
  }
}
