{
  "name": "luna-menu",
  "source": "local",
  "alias": ["menu"],
  "deps": [
    {"name": "quickshell", "source": "pacman", "purpose": "Render Luna's application menu"},
    {"name": "xdg-terminal-exec", "source": "pacman", "purpose": "Launch terminal applications from desktop entries"},
  ],
  "hooks": {
    // QML needs no compilation; refresh its source on every configuration run.
    "before_configure": ["scripts/configure.ts"],
    "after_configure": ["scripts/reload.ts"],
  },
  "exports": [
    {"source": "generated/shell/", "target": "menu/"},
  ],
}
