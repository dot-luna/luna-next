{
  "name": "btop",
  "source": "pacman",

  "exports": [
    {
      "source": "config/btop.conf",
      "target": "btop/btop.conf",

      "user_config": {
        "dest": [
          "$XDG_CONFIG_HOME/btop/btop.conf",
          "$HOME/.config/btop/btop.conf",
          "~/.config/btop/btop.conf",
        ],
        "dest_mode": "merge",
      },
    },
    {
      // Hyprland loads every fragment in hypr.d/.
      "source": "config/hyprland.lua",
      "target": "hypr.d/btop.lua",
    },
  ],
}
