{
  "name": "ungoogled-chromium-bin",
  "source": "aur",

  // Scripts run directly through their shebangs. Settings stay here; no exports are needed.
  "hooks": {
    "before_install": ["scripts/replace-chromium.sh"],
    "after_configure": ["scripts/create-profile.ts", "scripts/setup-profile.ts"],
  },
}
