{
  "enabled": false,
  "name": "bat",
  "source": "pacman",

  "exports": [
    {
      "source": "config/config.flags",
      "target": "bat/config.flags",

      "user_config": {
        "dest": ["$BAT_CONFIG_PATH", "!bat --config-file", "~/.config/bat/config"],
        "dest_mode": "merge",
      },
    },
  ],
  "cleanup": {
    "purge": [["$BAT_CONFIG_DIR", "$XDG_CONFIG_HOME/bat"], ["$XDG_CACHE_HOME/bat"]],
  },
}
