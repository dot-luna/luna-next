{
  "name": "gtk4",
  "source": "pacman",

  "hooks": {
    // Resolve the theme's blur before exporting the stylesheet.
    "before_configure": ["scripts/configure.ts"],
  },

  "exports": [
    {
      "source": "generated/gtk.css",
      "target": "gtk-4.0/gtk.css",

      "user_config": {
        "dest": ["$XDG_CONFIG_HOME/gtk-4.0/gtk.css", "~/.config/gtk-4.0/gtk.css"],
        // Import Luna's styles before personal rules so user overrides win.
        "dest_mode": "include",
      },
    },
  ],
}
