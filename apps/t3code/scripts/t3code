#!/usr/bin/env bash
# Launch the Luna-built T3 Code app using the concrete installation paths rendered by install.ts.
# Keep runtime overrides for theme/profile roots, refresh the theme, then forward original arguments.
set -euo pipefail

export T3CODE_DISABLE_AUTO_UPDATE=true
export T3CODE_DESKTOP_LAUNCHER_PATH=@LAUNCHER@
unset APPIMAGE APPDIR
@DEFAULTS@
@CLI@ theme apply t3code >/dev/null
exec @APPIMAGE@ "$@"
