{
  "name": "luna-notify",
  "source": "local",
  "alias": [["notify", ["luna", "notify"]]],
  "deps": [
    { "name": "quickshell", "source": "pacman", "purpose": "Show Luna notification toasts" },
    {
      "name": "systemd",
      "source": "pacman",
      "purpose": "Check notification ownership over the session bus",
    },
  ],
  "hooks": {
    "before_configure": ["scripts/configure.ts"],
    "after_configure": ["scripts/reload.ts"],
  },
  "exports": [
    { "source": "generated/shell/", "target": "notify/" },
    { "source": "config/notify.jsonc", "target": "notify.jsonc" },
  ],
}
