{
  "name": "kitty",
  "source": "pacman",

  "hooks": {
    "before_configure": ["scripts/configure.ts"],
  },

  "exports": [
    {
      "source": "generated/",
      "target": "kitty/",

      // The entry is exported separately to connect it to the user's configuration.
      "exclude": ["kitty.conf"],
    },
    {
      "source": "generated/kitty.conf",
      "target": "kitty/kitty.conf",

      "user_config": {
        "dest": [
          "$KITTY_CONFIG_DIRECTORY/kitty.conf",
          "$XDG_CONFIG_HOME/kitty/kitty.conf",
          "$HOME/.config/kitty/kitty.conf",
          "~/.config/kitty/kitty.conf",
        ],
        // Include Luna's defaults before personal settings so user overrides win.
        "dest_mode": "include",
      },
    },
  ],
}
