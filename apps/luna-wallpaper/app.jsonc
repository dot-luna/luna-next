{
  "enabled": true,
  "name": "luna-wallpaper",
  "source": "local",
  "alias": [["wallpaper", ["luna", "wallpaper"]]],
  "deps": [
    { "name": "mpvpaper", "source": "aur", "purpose": "Play video and animated PNG wallpapers" },
  ],
  "hooks": {
    "before_uninstall": ["scripts/stop.ts"],
    // Refresh QML and bundle the config watcher before exporting the app.
    "before_configure": ["scripts/configure.ts"],
    "after_configure": ["scripts/reload.ts"],
  },
  "exports": [
    { "source": "generated/shell/", "target": "wallpaper/" },
    { "source": "config/wallpaper.jsonc", "target": "wallpaper.jsonc" },
  ],
  "cleanup": {
    "uninstall": [["$LUNA_CONFIG_HOME_DIR/wallpaper"]],
    "purge": [
      ["$LUNA_WALLPAPER_CONFIG", "$LUNA_CONFIG_HOME_DIR/wallpaper.jsonc"],
      ["$LUNA_DATA_HOME_DIR/wallpapers"],
    ],
  },
}
