{
  "enabled": false,
  "name": "luna-lock",
  "source": "local",
  "alias": [["lock", ["luna", "lock"]]],
  "deps": [
    {
      "name": "quickshell",
      "source": "pacman",
      "purpose": "Render Luna's session lock and authenticate with PAM",
    },
  ],
  "hooks": {
    "before_uninstall": ["scripts/stop.ts"],
    "before_configure": ["scripts/configure.ts"],
    "after_configure": ["scripts/reload.ts"],
  },
  "exports": [
    { "source": "generated/shell/", "target": "lock/" },
    { "source": "config/lock.jsonc", "target": "lock.jsonc" },
  ],
  "cleanup": {
    "purge": [["$LUNA_LOCK_CONFIG", "$LUNA_CONFIG_HOME_DIR/lock.jsonc"]],
    "uninstall": [["$LUNA_CONFIG_HOME_DIR/lock"]],
  },
}
